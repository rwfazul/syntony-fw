{
  "services": {
    "monitor_application_service": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "composer_application_service": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "monitor_external_dependency": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "composer_external_dependency": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "cep": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "coordinator": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "executor": {
      "environment": {
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      }
    },
    "monitor_operating_system": {
      "image": "${IMAGE_PREFIX:-syntony}-monitor:${IMAGE_TAG:-dev}",
      "init": true,
      "environment": {
        "REDIS_URL": "redis://redis:6379/0",
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      },
      "depends_on": {
        "redis": {
          "condition": "service_healthy"
        },
        "gateway": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        "../../../config:/app/config:ro",
        "../../../specifications:/app/specifications:ro"
      ],
      "command": [
        "python",
        "-m",
        "runtime",
        "monitor",
        "--domain",
        "operating_system"
      ]
    },
    "composer_operating_system": {
      "image": "${IMAGE_PREFIX:-syntony}-composer:${IMAGE_TAG:-dev}",
      "init": true,
      "environment": {
        "REDIS_URL": "redis://redis:6379/0",
        "SYNTONY_CONFIG_PATH": "/app/config/service-resilience-host-guard.json"
      },
      "depends_on": {
        "redis": {
          "condition": "service_healthy"
        },
        "gateway": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        "../../../config:/app/config:ro",
        "../../../specifications:/app/specifications:ro"
      ],
      "command": [
        "python",
        "-m",
        "runtime",
        "composer",
        "--domain",
        "operating_system"
      ]
    }
  }
}
